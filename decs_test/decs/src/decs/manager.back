	// 	Ok(out_components)
	// }

	pub fn get_components_global_mut<C: Component>(&mut self) -> Result<Vec<&mut C>, String>
	{
		let component_type_id = TypeId::of::<C>();

		let mut out_components = vec![];

		for entity in self.entities.iter_mut()
		{
			let components = 
				match entity.components.get_mut(&component_type_id)
				{
					Some(components) => { components }
					None => { continue; }
				};

			out_components.append(&mut components.iter_mut().map(|component| component.as_any_mut().downcast_mut::<C>().unwrap()).collect::<Vec<&mut C>>());
		}
		
		Ok(out_components)
	}

	pub unsafe fn get_components_global_mut_unchecked<C: Component>(&self) -> Result<Vec<QueryResult<C>>, String>
	{
		let component_type_id = TypeId::of::<C>();

		let mut out_components = vec![];

		for entity in self.entities.iter()
		{
			let components = 
				match entity.components.get(&component_type_id)
				{
					Some(components) => { components }
					None => { continue; }
				};

			out_components.append(
				&mut components.iter()
				.map(
					|component| 
					{
						let reference = component.as_any().downcast_ref::<C>().unwrap();
						QueryResult{ entity_id:  entity.id, component: ((reference as *const C) as *mut C).as_mut().unwrap() } 
					}
					
				)
				.collect::<Vec<QueryResult<C>>>()
			);
		}
		
		Ok(out_components)
	}


	pub fn modify_components<C: Component>(
		&mut self, 
		entity_id: usize, 
		mut modifier_fn: impl FnMut(&mut C) -> Result<(), String>,
	) -> Result<(), String>
	{
		let entity_index = self.get_entity_index(entity_id)?;

		let component_type_id = TypeId::of::<C>();

		let components = 
			match self.entities[entity_index].components.get_mut(&component_type_id)
			{
				Some(components) => { components }
				None => { return Err(format!("entity [{}] doesn't contain components of type \"{}\"", entity_id, any::type_name::<C>())) }
			};

		for component in components.iter_mut()
		{
			modifier_fn(component.as_mut().as_any_mut().downcast_mut().unwrap())?;
		}

		Ok(())
	}

	pub fn modify_components_global<C: Component>(
		&mut self, 
		mut modifier_fn: impl FnMut(&mut C) -> Result<(), String>,
	) -> Result<(), String>
	{
		let component_type_id = TypeId::of::<C>();

		for entity in self.entities.iter_mut()
		{
			let components = 
				match entity.components.get_mut(&component_type_id)
				{
					Some(components) => { components }
					None => { continue; }
				};

			for component in components.iter_mut()
			{
				modifier_fn(component.as_mut().as_any_mut().downcast_mut().unwrap())?;
			}
		}

		Ok(())
	}

	pub fn modify_components_filter<C: Component>(
		&mut self, 
		entity_id: usize, 
		mut modifier_fn: impl FnMut(&mut C) -> Result<(), String>,
		filter_fn: impl Fn(&C) -> bool,
	) -> Result<(), String>
	{
		let entity_index = self.get_entity_index(entity_id)?;

		let component_type_id = TypeId::of::<C>();

		let components = 
			match self.entities[entity_index].components.get_mut(&component_type_id)
			{
				Some(components) => { components }
				None => { return Err(format!("entity [{}] doesn't contain components of type \"{}\"", entity_id, any::type_name::<C>())) }
			};

		for component in components.iter_mut()
		{
			let component_ref = component.as_mut().as_any_mut().downcast_mut().unwrap();
			if filter_fn(component_ref)
			{
				modifier_fn(component_ref)?;
			}
		}

		Ok(())
	}
	
	pub fn get_entities_with<C: Component>(
		&self,
	) -> Vec<usize>
	{
		let mut out_entity_vec = vec![];

		for entity in self.entities.iter()
		{
			match self.get_components::<C>(entity.id)
			{
				Ok(comp_vec) => { if comp_vec.len() > 0 { out_entity_vec.push(entity.id) } } 
				Err(_) => {}
			};
		}

		out_entity_vec.sort();
		out_entity_vec.dedup();

		out_entity_vec
	}

	pub fn get_entities_with_components_filter<C: Component>(
		&self,
		filter_fn: impl Fn(&C) -> bool,
	) -> Vec<usize>
	{
		let mut out_entity_vec = vec![];

		for entity in self.entities.iter()
		{
			match self.get_components::<C>(entity.id)
			{
				Ok(comp_vec) => 
				{
					for component in comp_vec
					{
						if filter_fn(component)
						{
							out_entity_vec.push(entity.id)
						}
					}
				} 
				Err(_) => {}
			};
		}

		out_entity_vec.sort();
		out_entity_vec.dedup();

		out_entity_vec
	}

	pub fn get_entity_with_components_filter<C: Component>(
		&self,
		filter_fn: impl Fn(&C) -> bool,
	) -> Option<usize>
	{
		for entity in self.entities.iter()
		{
			match self.get_components::<C>(entity.id)
			{
				Ok(comp_vec) => 
				{
					for component in comp_vec
					{
						if filter_fn(component)
						{
							return Some(entity.id)
						}
					}
				} 
				Err(_) => {}
			};
		}

		None
	}
}